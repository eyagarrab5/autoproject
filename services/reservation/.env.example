CARS_SERVICE_URL=http://localhost:3002

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Agence Location <your_email@gmail.com>"
