    {
      "name": "Password Reset",
      "item": [
        {
          "name": "Forgot Password - Request Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.resetToken) {",
                  "        pm.collectionVariables.set(\"resetToken\", jsonData.resetToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Request a password reset token. An email will be sent with reset instructions."
          },
          "response": []
        },
        {
          "name": "Verify Reset Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-reset-token/{{resetToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-reset-token", "{{resetToken}}"]
            },
            "description": "Verify if a reset token is valid and not expired"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Reset password using the token received via email"
          },
          "response": []
        },
        {
          "name": "Get User Reset Tokens (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-tokens/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-tokens", "{{userId}}"]
            },
            "description": "Get all reset tokens for a specific user (Admin only)"
          },
          "response": []
        },
        {
          "name": "Cleanup Expired Tokens (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-tokens/cleanup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-tokens", "cleanup"]
            },
            "description": "Delete all expired and used reset tokens (Admin only)"
          },
          "response": []
        }
      ],
      "description": "Password reset functionality with email verification"
