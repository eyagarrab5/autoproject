// Fonction pour afficher les entretiens dans le tableau
function displayEntretiens(entretiens) {
    const tbody = document.querySelector('#entretiensTable tbody');
    if (!tbody) {
        console.error('Tableau entretiens non trouvé');
        return;
    }
    
    tbody.innerHTML = '';
    
    if (!Array.isArray(entretiens) || entretiens.length === 0) {
        const tr = document.createElement('tr');
        tr.innerHTML = '<td colspan="8" class="text-center text-muted">Aucun entretien trouvé</td>';
        tbody.appendChild(tr);
        return;
    }
    
    // Trier par date (plus récent d'abord)
    entretiens.sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));
    
    entretiens.forEach(e => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${e.car?._id || e.car || 'N/A'}</td>
