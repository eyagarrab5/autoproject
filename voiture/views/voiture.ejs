// Charger les données d'un entretien dans le formulaire
function loadEntretienInForm(entretien) {
    if (!entretien) return;
    
    // Mettre à jour le titre du formulaire
    const formTitle = document.getElementById('entretienFormTitle');
    if (formTitle) {
        formTitle.textContent = 'Modifier un entretien';
    }
    
    // Remplir les champs du formulaire
    if (entretien.car) {
        document.getElementById('entretienMatr').value = entretien.car._id || entretien.car;
    }
    if (entretien.type) {
        document.getElementById('entretienType').value = entretien.type;
    }
    if (entretien.date) {
        // Formater la date au format YYYY-MM-DD pour l'input date
        const date = new Date(entretien.date);
        const formattedDate = date.toISOString().split('T')[0];
        document.getElementById('entretienDate').value = formattedDate;
    }
    document.getElementById('entretienDescription').value = entretien.description || '';
    document.getElementById('entretienCout').value = entretien.cout || '';
    document.getElementById('entretienPieces').value = entretien.piecesReconditionnees || entretien.piecesReconditionneesPct || '0';
    document.getElementById('entretienDechets').value = entretien.dechets || entretien.dechetsKg || '0';
    
    // Ajouter un champ caché pour l'ID de l'entretien en cours de modification
    let idInput = document.getElementById('entretienId');
    if (!idInput) {
        idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.id = 'entretienId';
        entretienForm.appendChild(idInput);
    }
    idInput.value = entretien._id || '';
    
    // Mettre à jour le bouton de soumission
    const submitBtn = entretienForm.querySelector('button[type="submit"]');
    if (submitBtn) {
        submitBtn.innerHTML = '<i class="bi bi-save"></i> Mettre à jour';
        submitBtn.classList.remove('btn-primary');
        submitBtn.classList.add('btn-warning');
    }
    
    // Afficher le bouton d'annulation
    const cancelBtn = document.getElementById('cancelEditBtn');
    if (cancelBtn) {
        cancelBtn.classList.remove('d-none');
    }
    
    // Faire défiler jusqu'au formulaire
    entretienForm.scrollIntoView({ behavior: 'smooth' });
}

