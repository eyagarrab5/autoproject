// ==================== INITIALISATION ENTRETIENS ====================

function initEntretiens() {
    console.log('🔄 Initialisation section entretiens...');
    
    try {
        // 1. Configurer le formulaire d'entretien
        console.log('📝 Configuration formulaire...');
        setupEntretienForm();
        
        // 2. Configurer la suppression
        console.log('🗑️ Configuration suppression...');
        setupEntretienDelete();
        
        // 3. Configurer les filtres
        console.log('🔍 Configuration filtres...');
        setupEntretienFilters();
        
        // 4. Configurer la maintenance prédictive
        console.log('🔮 Configuration maintenance prédictive...');
        setupPredictiveMaintenance();
        
        // 5. Définir la date du jour par défaut
        const today = new Date().toISOString().split('T')[0];
        const dateInput = document.getElementById('entretienDate');
        if (dateInput) {
            dateInput.value = today;
            console.log('📅 Date définie:', today);
        }
        
        console.log('✅ Section entretiens initialisée');
        
    } catch (error) {
        console.error('❌ Erreur initialisation entretiens:', error);
        showAlert('danger', 'Erreur initialisation entretiens: ' + error.message);
    }
}

