// Fonction pour charger les options des voitures dans le select d'entretien
async function loadVoituresOptions() {
    try {
        console.log('Chargement des options de voitures...');
        const response = await fetch(API_VOITURES);
        if (!response.ok) {
            throw new Error(`Erreur HTTP! statut: ${response.status}`);
        }
        const voitures = await response.json();
        
        // Mettre à jour le select du formulaire d'ajout d'entretien
        const selectEntretien = document.getElementById('car');
        
        if (selectEntretien) {
            // Sauvegarder la sélection actuelle
            const selectedValue = selectEntretien.value;
            
            // Vider et réinitialiser les options
            selectEntretien.innerHTML = '<option value="">Sélectionnez une voiture</option>';
            
            if (Array.isArray(voitures)) {
                // Trier les voitures par matricule
                voitures.sort((a, b) => a.matricule.localeCompare(b.matricule));
                
                // Ajouter les options des voitures
                voitures.forEach(voiture => {
                    if (voiture && voiture._id && voiture.matricule) {
                        const option = document.createElement('option');
                        option.value = voiture._id;
                        option.textContent = `${voiture.marque || ''} ${voiture.modele || ''} (${voiture.matricule})`.trim();
                        selectEntretien.appendChild(option);
                    }
                });
                
                // Restaurer la sélection si elle existe toujours
                if (selectedValue) {
                    selectEntretien.value = selectedValue;
                }
            } else {
                console.error('Les données reçues ne sont pas un tableau:', voitures);
            }
        }
        
        console.log('Options de voitures chargées avec succès');
    } catch (error) {
        console.error('Erreur lors du chargement des options de voitures:', error);
        showAlert('danger', 'Erreur lors du chargement des voitures');
    }
}

// Charger les voitures dans le select d'entretien
async function loadVoituresOptionsEntretien() {
    try {
        console.log('Chargement des options de voitures pour les entretiens...');
        const response = await fetch(API_VOITURES);
        
        if (!response.ok) {
            throw new Error(`Erreur HTTP! statut: ${response.status}`);
        }
        
        const voitures = await response.json();
        
        // IMPORTANT: Vérifiez que vous utilisez les BONS IDs
        // Pour le formulaire d'ajout d'entretien
        const selectEntretien = document.getElementById('entretienMatr');
        // Pour le filtre d'entretien
        const selectFilter = document.getElementById('filterEntretienMatr');
        
        if (selectEntretien && selectFilter) {
            // Sauvegarder les sélections actuelles
            const selectedValue = selectEntretien.value;
            const filterSelectedValue = selectFilter.value;
            
            // Réinitialiser les options
            selectEntretien.innerHTML = '<option value="">Sélectionnez une voiture...</option>';
            selectFilter.innerHTML = '<option value="">-- Toutes --</option>';
            
            // Vérifier et traiter les voitures
            if (Array.isArray(voitures) && voitures.length > 0) {
                // Trier par immatriculation
                const voituresTriees = [...voitures].sort((a, b) => {
                    const immatA = a._id || a.matricule || '';
                    const immatB = b._id || b.matricule || '';
                    return immatA.localeCompare(immatB);
                });
                
                // Ajouter les options
                voituresTriees.forEach(voiture => {
                    if (voiture && voiture._id) {
                        const immat = voiture._id;
                        const marque = voiture.marque || '';
                        const modele = voiture.modele || '';
                        const label = `${immat} - ${marque} ${modele}`.trim();
                        
                        // Pour le formulaire
                        const optionEntretien = document.createElement('option');
                        optionEntretien.value = voiture._id;
                        optionEntretien.textContent = label;
                        selectEntretien.appendChild(optionEntretien);
                        
                        // Pour le filtre
                        const optionFilter = document.createElement('option');
                        optionFilter.value = voiture._id;
                        optionFilter.textContent = label;
                        selectFilter.appendChild(optionFilter);
                    }
                });
                
                // Restaurer les sélections
                if (selectedValue) selectEntretien.value = selectedValue;
                if (filterSelectedValue) selectFilter.value = filterSelectedValue;
                
                console.log('Options chargées:', voituresTriees.length, 'voitures');
            }
        } else {
            console.error('Selects non trouvés!');
            console.log('entretienMatr:', selectEntretien);
            console.log('filterEntretienMatr:', selectFilter);
        }
        
    } catch (error) {
        console.error('Erreur lors du chargement des options de voitures:', error);
        showAlert('danger', 'Erreur lors du chargement des voitures');
    }
}

