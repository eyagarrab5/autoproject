			<!-- Maintenance Prédictive -->
			<div class="card mt-4">
				<div class="card-header bg-danger text-white">
					<h5 class="mb-0"><i class="bi bi-clipboard2-pulse"></i> Maintenance Prédictive</h5>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-4">
							<div class="card bg-light">
								<div class="card-body">
									<h6 class="card-title">Voitures à maintenir dans 15 jours</h6>
									<p class="card-text" id="predict15jours">-</p>
								</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="card bg-light">
								<div class="card-body">
									<h6 class="card-title">Alertes prioritaires</h6>
									<p class="card-text" id="predictAlertes">-</p>
								</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="card bg-light">
								<div class="card-body">
									<h6 class="card-title">Coût estimé 30 jours</h6>
									<p class="card-text" id="predictCout30j">- dt</p>
								</div>
							</div>
						</div>
					</div>
					<div class="row mt-3">
						<div class="col-12 text-center">
							<button class="btn btn-danger" id="predictBtn">
								<i class="bi bi-calculator"></i> Calculer la maintenance prédictive
							</button>
							<button class="btn btn-outline-danger ms-2" id="predictDetailsBtn">
								Voir les détails
							</button>
						</div>
					</div>
					<div class="row mt-3">
						<div class="col-12">
							<div id="predictDetails" style="display: none;">
								<!-- Détails de la maintenance prédictive -->
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script>
	// Configuration de l'API
const API_BASE = 'http://localhost:3000/api';
const API_VOITURES = `${API_BASE}/voitures`;
const ENT_BASE = `${API_BASE}/entretiens`;

// ==================== FONCTIONS UTILITAIRES ====================

// Fonction pour obtenir la classe CSS du badge d'état
function getEtatBadgeClass(etat) {
    switch(etat) {
        case 'available': return 'bg-success';
        case 'rented': return 'bg-primary';
        case 'maintenance': return 'bg-warning text-dark';
        case 'unavailable': return 'bg-secondary';
        default: return 'bg-light text-dark';
    }
}

// Fonction pour obtenir le texte d'état lisible
function getEtatText(etat) {
    const etats = {
        'available': 'Disponible',
        'rented': 'Louée',
        'maintenance': 'En maintenance',
        'unavailable': 'Indisponible'
    };
    return etats[etat] || etat;
}

// Fonction pour obtenir la classe CSS du badge de type d'entretien
function getTypeBadgeClass(type) {
    switch(type) {
        case 'routine': return 'bg-info';
        case 'reparation': return 'bg-danger';
        case 'inspection': return 'bg-warning';
        case 'autre': return 'bg-secondary';
        default: return 'bg-light text-dark';
    }
}

// Fonction pour obtenir le texte de type d'entretien lisible
function getTypeText(type) {
    switch(type) {
        case 'routine': return 'Routine';
        case 'reparation': return 'Réparation';
        case 'inspection': return 'Inspection';
        case 'autre': return 'Autre';
        default: return type || 'Inconnu';
    }
}

// Fonction utilitaire pour afficher les alertes
function showAlert(type, message) {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
    alertDiv.role = 'alert';
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    `;
    
    const container = document.querySelector('.container');
    container.insertBefore(alertDiv, container.firstChild);
    
    // Supprimer l'alerte après 5 secondes
    setTimeout(() => {
        if (alertDiv.parentNode) {
            alertDiv.remove();
        }
    }, 5000);
}

// ==================== CHARGEMENT DES VOITURES ====================

// Charger les voitures
async function loadVoitures() {
    try {
        console.log('Chargement des voitures...');
        const res = await fetch(API_VOITURES);
        
        if (!res.ok) {
            throw new Error(`Erreur HTTP! status: ${res.status}`);
        }
        
        const voitures = await res.json();
        console.log('Voitures reçues:', voitures);
        
        const tbody = document.querySelector('#voituresTable tbody');
        if (!tbody) {
            throw new Error('Élément tbody non trouvé dans le DOM');
        }
        tbody.innerHTML = '';
        
        if (!Array.isArray(voitures)) {
            throw new Error('La réponse de l\'API n\'est pas un tableau');
        }
        
        if (voitures.length === 0) {
            const tr = document.createElement('tr');
            tr.innerHTML = '<td colspan="10" class="text-center">Aucune voiture trouvée</td>';
            tbody.appendChild(tr);
            return;
        }
        
        voitures.forEach(v => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${v._id || ''}</strong></td>
                <td>${v.marque || ''}</td>
                <td>${v.modele || ''}</td>
                <td>${v.annee || ''}</td>
                <td><span class="badge bg-info">${v.carburant || ''}</span></td>
                <td>${v.kilometrage ? v.kilometrage.toLocaleString() : ''}</td>
                <td>
