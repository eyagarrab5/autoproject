        // Construire l'URL de recherche
        const params = new URLSearchParams();
        
        // IMPORTANT: Utiliser les noms de paramètres que le backend attend
        if (filters.carId) params.append('car', filters.carId);
        if (filters.type) params.append('type', filters.type);
        if (filters.minCout) params.append('minCout', filters.minCout);
        if (filters.maxCout) params.append('maxCout', filters.maxCout);
        
        // Toujours utiliser la route /search
        const url = `${ENT_BASE}/search?${params.toString()}`;
        console.log('📡 URL de requête:', url);
        
        const res = await fetch(url);
        if (!res.ok) {
            const errorText = await res.text();
            throw new Error(`Erreur HTTP ${res.status}: ${errorText}`);
