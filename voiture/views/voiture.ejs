// Gestionnaire pour le bouton d'annulation
document.addEventListener('click', (e) => {
    if (e.target && e.target.id === 'cancelEditBtn') {
        resetEntretienForm();
    }
});

// Gestionnaire du formulaire d'entretien
function setupEntretienForm() {
    const entretienForm = document.getElementById('entretienForm');
    
    if (!entretienForm) {
        console.error('ERREUR: Formulaire entretien non trouvé! Vérifiez id="entretienForm"');
        return;
    }
    
    console.log('Configuration du formulaire entretien...');
    
    // Supprimer les anciens listeners
    const newForm = entretienForm.cloneNode(true);
    entretienForm.parentNode.replaceChild(newForm, entretienForm);
    
    // Nouveau listener
    document.getElementById('entretienForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const form = e.target;
        const submitBtn = form.querySelector('button[type="submit"]');
        const isEditMode = document.getElementById('entretienId')?.value;
        
        try {
            // Désactiver le bouton pendant la soumission
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ' + 
                                (isEditMode ? 'Mise à jour...' : 'Enregistrement...');
            
            const entretienData = {
                matr: form.entretienMatr.value,
                type: form.entretienType.value,
                date: form.entretienDate.value,
                description: form.entretienDescription.value,
                cout: parseFloat(form.entretienCout.value) || 0,
                piecesReconditionnees: parseInt(form.entretienPieces.value) || 0,
                dechets: parseFloat(form.entretienDechets.value) || 0
            };
            
            // Déterminer l'URL et la méthode en fonction du mode (création ou édition)
            const url = isEditMode ? `${ENT_BASE}/${document.getElementById('entretienId').value}` : ENT_BASE;
            const method = isEditMode ? 'PUT' : 'POST';
            
            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(entretienData)
            });
            
            
            let responseData;
            try {
                responseData = await response.json();
            } catch (jsonError) {
                console.error('Erreur parsing JSON:', jsonError);
                const text = await response.text();
                console.error('Réponse texte:', text);
                throw new Error(`Erreur serveur: ${response.status} - ${text}`);
            }
            
            if (!response.ok) {
                throw new Error(responseData.message || `Erreur ${response.status}`);
            }
            
            console.log('✅ Entretien créé:', responseData);
            showAlert('success', 'Entretien enregistré avec succès !');
            
            // Réinitialiser le formulaire
            resetEntretienForm();
            
            // Recharger les données
            await Promise.all([
                loadEntretiens(),
                loadStatsEntretiens()
            ]);
            
            // Recharger les options des voitures si nécessaire
            if (!document.getElementById('entretienMatr').options.length) {
                await loadVoituresOptionsEntretien();
            }
            
        } catch (error) {
            console.error('❌ Erreur détaillée:', error);
            console.error('Stack trace:', error.stack);
            showAlert('danger', `Erreur: ${error.message}`);
        } finally {
            // Réactiver le bouton
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    });
    
    console.log('✅ Formulaire entretien configuré');
}

// Supprimer un entretien
function setupEntretienDelete() {
    const tbody = document.querySelector('#entretiensTable tbody');
    if (!tbody) return;
    
    // Supprimer les anciens listeners
    const newTbody = tbody.cloneNode(true);
    tbody.parentNode.replaceChild(newTbody, tbody);
    
    // Nouveau listener
    document.querySelector('#entretiensTable tbody').addEventListener('click', async (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        
        if (btn.dataset.action === 'delete-entretien') {
            const id = btn.dataset.id;
            if (!confirm('Supprimer cet entretien ?')) return;
            
            try {
                const res = await fetch(`${ENT_BASE}/${id}`, {
                    method: 'DELETE'
                });
                
                if (!res.ok) throw new Error('Suppression échouée');
                
                showAlert('success', 'Entretien supprimé!');
                await loadEntretiens();
                await loadStatsEntretiens();
            } catch (err) {
                console.error('Erreur suppression entretien:', err);
                showAlert('danger', 'Erreur lors de la suppression');
            }
        }
    });
}

// Filtrer les entretiens
function setupEntretienFilters() {
    const filterBtn = document.getElementById('applyEntretienFiltersBtn');
    if (!filterBtn) {
        console.error('Bouton de filtre des entretiens non trouvé');
        return;
    }
    
    // Supprimer ancien listener
    const newBtn = filterBtn.cloneNode(true);
    filterBtn.parentNode.replaceChild(newBtn, filterBtn);
    
    // Nouveau listener
    newBtn.addEventListener('click', async () => {
        const filters = {};
        
        // Récupérer les valeurs des champs de filtre
        const carId = document.getElementById('filterEntretienMatr').value;
        const type = document.getElementById('filterEntretienType').value;
        const minCout = document.getElementById('filterEntretienMinCout').value;
        const maxCout = document.getElementById('filterEntretienMaxCout').value;
        
        // Ajouter uniquement les filtres non vides
        if (carId) filters.carId = carId;
        if (type) filters.type = type;
        
        // Valider et ajouter les filtres numériques
        if (minCout) {
            if (isNaN(parseFloat(minCout))) {
                showAlert('warning', 'Le coût minimum doit être un nombre valide');
                return;
            }
            filters.minCout = minCout;
        }
        
        if (maxCout) {
            if (isNaN(parseFloat(maxCout))) {
                showAlert('warning', 'Le coût maximum doit être un nombre valide');
                return;
            }
            filters.maxCout = maxCout;
        }
        
        console.log('Filtres entretiens appliqués:', filters);
        
        try {
            await loadEntretiens(filters);
        } catch (err) {
            console.error('Erreur lors du filtrage des entretiens:', err);
            showAlert('danger', 'Erreur lors du filtrage des entretiens: ' + (err.message || 'Erreur inconnue'));
        }
    });
    
    // Activer le bouton de filtre
    newBtn.disabled = false;
}

// Charger les statistiques entretiens
async function loadStatsEntretiens() {
    try {
        const res = await fetch(`${ENT_BASE}/stats`);
        if (!res.ok) throw new Error('Erreur stats entretiens');
        const stats = await res.json();
        
        const coutTotal = stats.costSummary?.[0]?.totalCout || 0;
        const coutMoyen = stats.costSummary?.[0]?.avgCout || 0;
        const totalEntretiens = stats.totals?.[0]?.total || 0;
        
        document.getElementById('statCoutTotal').textContent = coutTotal.toFixed(2) + ' dt';
        document.getElementById('statCoutMoyen').textContent = coutMoyen.toFixed(2) + ' dt';
        document.getElementById('statTotalEntretiens').textContent = totalEntretiens;
    } catch (err) {
        console.error('Erreur stats entretiens:', err);
    }
}

// Maintenance prédictive
function setupPredictiveMaintenance() {
    const predictBtn = document.getElementById('predictBtn');
    if (!predictBtn) return;
    
    const newBtn = predictBtn.cloneNode(true);
    predictBtn.parentNode.replaceChild(newBtn, predictBtn);
    
    document.getElementById('predictBtn').addEventListener('click', async () => {
        try {
            const submitBtn = document.getElementById('predictBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Calcul...';
            
            const res = await fetch(`${ENT_BASE}/predict`);
            if (!res.ok) throw new Error('Erreur prédiction');
            const prediction = await res.json();
            
            document.getElementById('predict15jours').textContent = 
                prediction.resume?.a_venir_15_jours || '0';
            document.getElementById('predictAlertes').textContent = 
                prediction.alertes_prioritaires?.length || '0';
            document.getElementById('predictCout30j').textContent = 
                prediction.resume?.cout_estime_30_jours?.toFixed(2) || '0';
            
            const detailsDiv = document.getElementById('predictDetails');
            detailsDiv.style.display = 'block';
            
            let detailsHTML = `
                <h6>Détails de la maintenance prédictive</h6>
                <div class="alert alert-info">
                    <strong>Résumé:</strong> ${prediction.resume?.vehicules_total || 0} voitures, 
                    ${prediction.resume?.entretiens_total || 0} entretiens historiques
                </div>
            `;
            
            if (prediction.vehicules_a_maintenir_15j?.length > 0) {
                detailsHTML += `
                    <h6>Voitures à maintenir dans 15 jours:</h6>
                    <ul class="list-group">
                `;
                prediction.vehicules_a_maintenir_15j.forEach(v => {
                    detailsHTML += `
                        <li class="list-group-item">
                            ${v.id} - ${v.marque} ${v.modele} 
                            <span class="badge bg-warning">${v.urgence_maintenance_jours} jours</span>
                            <span class="badge bg-secondary">Coût estimé: ${v.cout_estime} dt</span>
                        </li>
                    `;
                });
                detailsHTML += `</ul>`;
            }
            
            if (prediction.alertes_prioritaires?.length > 0) {
                detailsHTML += `
                    <h6 class="mt-3">Alertes prioritaires:</h6>
                    <div class="alert alert-warning">
                        <ul>
                `;
                prediction.alertes_prioritaires.forEach(alerte => {
                    detailsHTML += `<li>${alerte}</li>`;
                });
                detailsHTML += `
                        </ul>
                    </div>
                `;
            }
            
            document.getElementById('predictDetails').innerHTML = detailsHTML;
        } catch (err) {
            console.error('Erreur prédiction maintenance:', err);
            showAlert('danger', 'Erreur lors de la prédiction de maintenance');
        } finally {
            const submitBtn = document.getElementById('predictBtn');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-calculator"></i> Calculer la maintenance prédictive';
        }
    });
}

