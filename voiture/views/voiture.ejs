// Tri des voitures (client)
document.getElementById('applySortBtn').addEventListener('click', () => {
    const param = document.getElementById('sortParam').value; // tarifJournalier | kilometrage | annee
    const order = document.getElementById('sortOrder').value; // asc | desc
    const colMap = { tarifJournalier: 7, kilometrage: 5, annee: 3 };
    const col = colMap[param] || 7;
    const factor = order === 'asc' ? 1 : -1;
    const tbody = document.querySelector('#voituresTable tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    
    const parseNumber = (text) => {
        if (!text) return NaN;
        const cleaned = text.replace(/[^0-9.,-]/g, '').replace(/,/g, '');
        return parseFloat(cleaned);
    };
    
    rows.sort((r1, r2) => {
        const t1 = r1.children[col]?.textContent || '';
        const t2 = r2.children[col]?.textContent || '';
        const n1 = parseNumber(t1);
        const n2 = parseNumber(t2);
        const v1 = isNaN(n1) ? Number.NEGATIVE_INFINITY : n1;
        const v2 = isNaN(n2) ? Number.NEGATIVE_INFINITY : n2;
        if (v1 < v2) return -1 * factor;
        if (v1 > v2) return 1 * factor;
        return 0;
    });
    rows.forEach(r => tbody.appendChild(r));
});

// Charger les statistiques voitures
async function loadStatsVoitures() {
    try {
        const res = await fetch(`${API_VOITURES}/stats`);
        if (!res.ok) throw new Error('Erreur stats');
        const stats = await res.json();
        
        // Totaux
        document.getElementById('statTotalVoitures').textContent = 
            stats.totals?.[0]?.total || '0';
        
        // Calculer les états
        const disponibles = stats.countByEtat?.find(e => e._id === 'available')?.count || 0;
        const maintenance = stats.countByEtat?.find(e => e._id === 'maintenance')?.count || 0;
        document.getElementById('statDisponibles').textContent = disponibles;
        document.getElementById('statMaintenance').textContent = maintenance;
        
        // Tarif moyen
        const tarifMoyen = stats.pricing?.[0]?.avgTarif;
        document.getElementById('statTarifMoyen').textContent = 
            tarifMoyen ? tarifMoyen.toFixed(2) + ' dt' : '-';
        
        // Répartition carburant
        const carburantList = document.getElementById('statsCarburant');
        carburantList.innerHTML = '';
        if (stats.countByCarburant) {
            stats.countByCarburant.forEach(c => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between';
                li.innerHTML = `<span>${c._id || 'Non spécifié'}</span><span class="badge bg-primary">${c.count}</span>`;
                carburantList.appendChild(li);
            });
        }
        
        // Répartition état
        const etatList = document.getElementById('statsEtat');
        etatList.innerHTML = '';
        if (stats.countByEtat) {
            stats.countByEtat.forEach(e => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between';
                const badgeClass = getEtatBadgeClass(e._id);
                li.innerHTML = `<span>${getEtatText(e._id)}</span><span class="badge ${badgeClass}">${e.count}</span>`;
                etatList.appendChild(li);
            });
        }
    } catch (err) {
        console.error('Erreur stats voitures:', err);
    }
}

