// Gestion du formulaire de voiture
const voitureForm = document.getElementById('voitureForm');
if (voitureForm) {
    voitureForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const form = e.target;
        const isEditing = form.dataset.editing === 'true';
        const submitBtn = form.querySelector('button[type="submit"]');
        
        try {
            // Désactiver le bouton pendant le traitement
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Traitement...';
            
            // Récupérer les valeurs du formulaire
            const voitureData = {
                _id: document.getElementById('matr').value.trim(),
                marque: document.getElementById('marque').value.trim(),
                modele: document.getElementById('modele').value.trim(),
                annee: document.getElementById('annee').value ? parseInt(document.getElementById('annee').value) : null,
                carburant: document.getElementById('carburant').value,
                kilometrage: document.getElementById('kilometrage').value ? parseInt(document.getElementById('kilometrage').value) : 0,
                etat: document.getElementById('etat').value,
                tarifJournalier: document.getElementById('tarifJournalier').value ? parseFloat(document.getElementById('tarifJournalier').value) : 0
            };
            
            console.log('Données du formulaire:', voitureData);

            // Validation des champs obligatoires
            if (!voitureData._id || !voitureData.marque || !voitureData.modele) {
                throw new Error('Les champs immatriculation, marque et modèle sont obligatoires');
            }

            const url = isEditing 
                ? `${API_VOITURES}/${submitBtn.dataset.editingId}`
                : API_VOITURES;
                
            const method = isEditing ? 'PUT' : 'POST';
            
            console.log(`Envoi de la requête ${method} à ${url}`, voitureData);

            const res = await fetch(url, {
                method,
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(voitureData)
            });
            
            const responseData = await res.json().catch(() => ({}));
            
            if (!res.ok) {
                console.error('Erreur API:', responseData);
                throw new Error(
                    responseData.message || 
                    `Erreur ${res.status}: ${res.statusText}` || 
                    'Une erreur est survenue lors de la communication avec le serveur'
                );
            }
            
            console.log('Réponse du serveur:', responseData);
            
            showAlert('success', `Voiture ${isEditing ? 'mise à jour' : 'créée'} avec succès !`);
            
            // Réinitialiser le formulaire
            form.reset();
            form.dataset.editing = 'false';
            delete submitBtn.dataset.editingId;
            submitBtn.innerHTML = '<i class="bi bi-save"></i> Enregistrer la voiture';
            submitBtn.classList.remove('btn-warning');
            submitBtn.classList.add('btn-primary');
            
            // Recharger la liste des voitures
            await loadVoitures();
            
        } catch (err) {
            console.error('Erreur lors de la soumission du formulaire:', err);
            const errorMessage = err.message.includes('Failed to fetch') 
                ? 'Impossible de se connecter au serveur. Veuillez vérifier votre connexion.'
                : err.message;
                
            showAlert('danger', errorMessage);
            
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = isEditing 
                    ? '<i class="bi bi-save"></i> Mettre à jour'
                    : '<i class="bi bi-save"></i> Enregistrer la voiture';
            }
        }
    });
}

// Gestion des actions (éditer/supprimer)
document.addEventListener('click', async (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    
    const action = btn.getAttribute('data-action');
    const id = btn.getAttribute('data-id');
    
    if (action === 'delete-voiture') {
        if (!confirm(`Supprimer la voiture ${id} ? Cette action est irréversible.`)) return;
        
        try {
            const res = await fetch(`${API_VOITURES}/${id}`, {
                method: 'DELETE'
            });
            
            if (!res.ok) throw new Error('Suppression échouée');
            
            showAlert('success', 'Voiture supprimée avec succès!');
            await loadVoitures();
        } catch (err) {
            console.error('Erreur suppression:', err);
            showAlert('danger', 'Erreur lors de la suppression');
        }
    } else if (action === 'edit') {
        // Récupérer les données de la voiture
        try {
            const res = await fetch(`${API_VOITURES}/${id}`);
            if (!res.ok) throw new Error('Impossible de récupérer les données');
            
            const voiture = await res.json();
            
            // Remplir le formulaire avec les données
            document.getElementById('matr').value = voiture._id || '';
            document.getElementById('marque').value = voiture.marque || '';
            document.getElementById('modele').value = voiture.modele || '';
            document.getElementById('annee').value = voiture.annee || '';
            document.getElementById('carburant').value = voiture.carburant || 'essence';
            document.getElementById('kilometrage').value = voiture.kilometrage || '';
            document.getElementById('etat').value = voiture.etat || 'available';
            document.getElementById('tarifJournalier').value = voiture.tarifJournalier || '';
            
            // Changer le texte du bouton
            const submitBtn = document.querySelector('#voitureForm button[type="submit"]');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="bi bi-save"></i> Mettre à jour';
                submitBtn.classList.remove('btn-primary');
                submitBtn.classList.add('btn-warning');
            }
            
            // Faire défiler jusqu'au formulaire
            document.getElementById('voitureForm').scrollIntoView({ behavior: 'smooth' });
            
        } catch (err) {
            console.error('Erreur chargement voiture:', err);
            showAlert('danger', 'Erreur lors du chargement des données de la voiture');
        }
    } else if (action === 'edit-entretien' && id) {
        try {
            console.log(`Chargement de l'entretien ${id}...`);
            const response = await fetch(`${ENT_BASE}/${id}`);
            if (!response.ok) {
                throw new Error('Erreur lors du chargement des données');
            }
            const entretien = await response.json();
            console.log('Données de l\'entretien chargées:', entretien);
            loadEntretienInForm(entretien);
        } catch (err) {
            console.error('Erreur lors du chargement de l\'entretien:', err);
            showAlert('danger', 'Erreur lors du chargement des données de l\'entretien: ' + err.message);
        }
    }
});

