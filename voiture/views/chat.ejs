<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Chat - Gestion Voitures</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
		<style>
			.chat-container {
				max-width: 800px;
				margin: 0 auto;
				height: 80vh;
				display: flex;
				flex-direction: column;
			}
			.chat-messages {
				flex-grow: 1;
				overflow-y: auto;
				border: 1px solid #dee2e6;
				border-radius: 0.375rem;
				padding: 15px;
				margin-bottom: 15px;
				background-color: #f8f9fa;
			}
			.message {
				margin-bottom: 10px;
				padding: 8px 12px;
				border-radius: 15px;
				max-width: 70%;
				word-wrap: break-word;
			}
			.message-sent {
				background-color: #007bff;
				color: white;
				margin-left: auto;
				border-bottom-right-radius: 5px;
			}
			.message-received {
				background-color: #e9ecef;
				color: #212529;
				margin-right: auto;
				border-bottom-left-radius: 5px;
			}
			.message-info {
				font-size: 0.8rem;
				color: #6c757d;
				margin-top: 2px;
			}
			.user-badge {
				display: inline-block;
				padding: 2px 8px;
				border-radius: 10px;
				font-size: 0.8rem;
				margin-right: 5px;
				font-weight: bold;
			}
		</style>
	</head>
	<body class="bg-light">
		<div class="container py-4">
			<div class="card chat-container">
				<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
					<h5 class="mb-0">
						<i class="bi bi-chat-dots"></i> Chat en temps réel - Gestion Voitures
					</h5>
					<div>
						<span class="badge bg-light text-primary" id="userCount">0 utilisateurs</span>
						<span class="badge bg-success ms-2" id="connectionStatus">Connecté</span>
					</div>
				</div>
				
				<div class="card-body">
					<div class="chat-messages" id="chatMessages">
						<!-- Messages apparaîtront ici -->
						<div class="text-center text-muted my-3" id="welcomeMessage">
							Bienvenue dans le chat ! Entrez votre nom ci-dessous pour commencer.
						</div>
					</div>
					
					<div class="input-group mb-3">
						<input type="text" 
							   id="messageInput" 
							   class="form-control" 
							   placeholder="Tapez votre message..." 
							   disabled>
						<button class="btn btn-primary" 
								id="sendButton" 
								type="button"
								disabled>
							<i class="bi bi-send"></i> Envoyer
						</button>
					</div>
					
					<div class="row g-2">
						<div class="col-md-8">
							<div class="input-group">
								<span class="input-group-text">
									<i class="bi bi-person-circle"></i>
								</span>
								<input type="text" 
									   id="usernameInput" 
									   class="form-control" 
									   placeholder="Votre nom pour le chat...">
							</div>
						</div>
						<div class="col-md-4">
							<button class="btn btn-success w-100" id="connectButton">
								<i class="bi bi-plug"></i> Se connecter
							</button>
						</div>
					</div>
					
					<div class="mt-3">
						<small class="text-muted">
							<i class="bi bi-info-circle"></i> 
							Ce chat permet la communication en temps réel entre les gestionnaires du parc auto.
						</small>
					</div>
				</div>
				
				<div class="card-footer text-muted">
					<div class="row">
						<div class="col-md-6">
							<small>
								<i class="bi bi-people"></i> 
								Utilisateurs connectés: <span id="connectedUsersList">Aucun</span>
							</small>
						</div>
						<div class="col-md-6 text-end">
							<button class="btn btn-sm btn-outline-secondary" id="clearChatBtn">
								<i class="bi bi-trash"></i> Effacer le chat
							</button>
						</div>
					</div>
				</div>
			</div>
			
			<div class="row mt-4">
				<div class="col-md-6">
					<div class="card">
						<div class="card-header">
							<h6 class="mb-0">
								<i class="bi bi-lightning-charge"></i> Commandes rapides
							</h6>
						</div>
						<div class="card-body">
							<div class="d-flex flex-wrap gap-2">
								<button class="btn btn-sm btn-outline-primary quick-message" data-msg="Besoin d'une voiture disponible">
									🚗 Disponible?
								</button>
								<button class="btn btn-sm btn-outline-warning quick-message" data-msg="Voiture en maintenance">
									🔧 Maintenance
								</button>
								<button class="btn btn-sm btn-outline-success quick-message" data-msg="Entretien terminé">
									✅ Entretien OK
								</button>
								<button class="btn btn-sm btn-outline-danger quick-message" data-msg="URGENT: Problème mécanique">
									🚨 URGENT
								</button>
								<button class="btn btn-sm btn-outline-info quick-message" data-msg="Rendez-vous client">
									📅 Rendez-vous
								</button>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-6">
					<div class="card">
						<div class="card-header">
							<h6 class="mb-0">
								<i class="bi bi-gear"></i> Paramètres du chat
							</h6>
						</div>
						<div class="card-body">
							<div class="form-check form-switch">
								<input class="form-check-input" type="checkbox" id="soundToggle" checked>
								<label class="form-check-label" for="soundToggle">
									Son des notifications
								</label>
							</div>
							<div class="form-check form-switch">
								<input class="form-check-input" type="checkbox" id="autoScrollToggle" checked>
								<label class="form-check-label" for="autoScrollToggle">
									Défilement automatique
								</label>
							</div>
							<div class="mt-2">
								<label for="userColor" class="form-label">Couleur de votre nom:</label>
								<input type="color" id="userColor" class="form-control form-control-color" value="#007bff">
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script src="/socket.io/socket.io.js"></script>
		<script>
			// Variables globales
			let socket = null;
			let username = null;
			let userColor = '#007bff';
			
			// Éléments DOM
			const messageInput = document.getElementById('messageInput');
			const sendButton = document.getElementById('sendButton');
			const usernameInput = document.getElementById('usernameInput');
			const connectButton = document.getElementById('connectButton');
			const chatMessages = document.getElementById('chatMessages');
			const welcomeMessage = document.getElementById('welcomeMessage');
			const userCount = document.getElementById('userCount');
			const connectionStatus = document.getElementById('connectionStatus');
			const connectedUsersList = document.getElementById('connectedUsersList');
			const clearChatBtn = document.getElementById('clearChatBtn');
			
			// Connexion au chat
			connectButton.addEventListener('click', () => {
				const inputName = usernameInput.value.trim();
				if (!inputName) {
					showAlert('warning', 'Veuillez entrer un nom');
					return;
				}
				
				username = inputName;
				userColor = document.getElementById('userColor').value;
				
				// Désactiver les champs de connexion
				usernameInput.disabled = true;
				connectButton.disabled = true;
				connectButton.innerHTML = '<i class="bi bi-check-circle"></i> Connecté';
				connectButton.classList.remove('btn-success');
				connectButton.classList.add('btn-secondary');
				
				// Activer les champs de message
				messageInput.disabled = false;
				sendButton.disabled = false;
				
				// Cacher le message de bienvenue
				welcomeMessage.style.display = 'none';
				
				// Connecter au socket
				connectSocket();
				
				showAlert('success', `Connecté en tant que ${username}`);
			});
			
			// Connexion Socket.io
			function connectSocket() {
				socket = io();
				
				// Gestion des événements
				socket.on('connect', () => {
					console.log('Connecté au serveur');
					connectionStatus.textContent = 'Connecté';
					connectionStatus.className = 'badge bg-success';
					
					// Envoyer l'identité de l'utilisateur
					socket.emit('register', { 
						username: username, 
						color: userColor 
					});
				});
				
				socket.on('disconnect', () => {
					console.log('Déconnecté du serveur');
					connectionStatus.textContent = 'Déconnecté';
					connectionStatus.className = 'badge bg-danger';
					showAlert('warning', 'Déconnecté du serveur. Reconnexion...');
				});
				
				socket.on('user_count', (count) => {
					userCount.textContent = `${count} utilisateur${count > 1 ? 's' : ''}`;
				});
				
				socket.on('user_list', (users) => {
					const userNames = users.map(u => u.username).join(', ');
					connectedUsersList.textContent = userNames || 'Aucun';
				});
				
				socket.on('chat_message', (data) => {
					displayMessage(data.username, data.message, data.color, false);
					
					// Jouer un son si activé
					if (document.getElementById('soundToggle').checked) {
						playNotificationSound();
					}
				});
				
				socket.on('system_message', (message) => {
					displaySystemMessage(message);
				});
				
				// Entrée sur le champ de message
				messageInput.addEventListener('keypress', (e) => {
					if (e.key === 'Enter' && !e.shiftKey) {
						e.preventDefault();
						sendMessage();
					}
				});
				
				// Bouton envoyer
				sendButton.addEventListener('click', sendMessage);
			}
			
			// Envoyer un message
			function sendMessage() {
				const message = messageInput.value.trim();
				if (!message || !socket) return;
				
				// Envoyer au serveur
				socket.emit('chat_message', {
					username: username,
					message: message,
					color: userColor
				});
				
				// Afficher localement
				displayMessage(username, message, userColor, true);
				
				// Vider le champ
				messageInput.value = '';
				messageInput.focus();
			}
			
			// Afficher un message dans le chat
			function displayMessage(sender, text, color, isSent = false) {
				const messageDiv = document.createElement('div');
				messageDiv.className = `message ${isSent ? 'message-sent' : 'message-received'}`;
				
				const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
				
				messageDiv.innerHTML = `
					<div class="user-badge" style="background-color: ${color}; color: white;">
						${sender}
					</div>
					<div class="message-text">${escapeHtml(text)}</div>
					<div class="message-info">
						${time} ${isSent ? '· Vous' : ''}
					</div>
				`;
				
				chatMessages.appendChild(messageDiv);
				
				// Défilement automatique
				if (document.getElementById('autoScrollToggle').checked) {
					chatMessages.scrollTop = chatMessages.scrollHeight;
				}
			}
			
			// Afficher un message système
			function displaySystemMessage(text) {
				const systemDiv = document.createElement('div');
				systemDiv.className = 'text-center text-muted my-2';
				systemDiv.innerHTML = `<i>${escapeHtml(text)}</i>`;
				
				chatMessages.appendChild(systemDiv);
				
				if (document.getElementById('autoScrollToggle').checked) {
					chatMessages.scrollTop = chatMessages.scrollHeight;
				}
			}
			
			// Effacer le chat
			clearChatBtn.addEventListener('click', () => {
				if (confirm('Effacer tous les messages du chat ?')) {
					chatMessages.innerHTML = `
						<div class="text-center text-muted my-3">
							Chat effacé. ${username ? 'Continuez la conversation!' : 'Entrez votre nom pour commencer.'}
						</div>
					`;
				}
			});
			
			// Messages rapides
			document.querySelectorAll('.quick-message').forEach(button => {
				button.addEventListener('click', () => {
					if (!username) {
						showAlert('warning', 'Veuillez d\'abord entrer votre nom');
						return;
					}
					
					const quickMsg = button.dataset.msg;
					messageInput.value = quickMsg;
					messageInput.focus();
				});
			});
			
			// Sons de notification
			function playNotificationSound() {
				try {
					const audio = new Audio('data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAZGF0YQQAAAAAAA==');
					audio.volume = 0.3;
					audio.play();
				} catch (e) {
					console.log('Erreur lecture son:', e);
				}
			}
			
			// Afficher une alerte temporaire
			function showAlert(type, message) {
				const alertDiv = document.createElement('div');
				alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
				alertDiv.style.zIndex = '1050';
				alertDiv.innerHTML = `
					${message}
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				`;
				
				document.body.appendChild(alertDiv);
				
				setTimeout(() => {
					if (alertDiv.parentNode) {
						alertDiv.remove();
					}
				}, 3000);
			}
			
			// Échapper le HTML pour la sécurité
			function escapeHtml(text) {
				const div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}
			
			// Auto-focus sur le champ nom au chargement
			document.addEventListener('DOMContentLoaded', () => {
				usernameInput.focus();
			});
		</script>
		
		<!-- Bootstrap Icons -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
		<!-- Bootstrap JS -->
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html>