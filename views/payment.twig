
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Paiements</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	</head>
	<body class="bg-light">
		<div class="container py-4">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<h1 class="h3">Gestion des paiements</h1>
				<small class="text-muted">Interface minimale pour créer et voir les paiements</small>
			</div>

			<div class="card mb-4">
				<div class="card-body">
					<h5 class="card-title">Créer un paiement</h5>
					<form id="paymentForm" class="row g-3">
						<div class="col-md-4">
							<label for="userId" class="form-label">User ID</label>
							<input type="text" id="userId" class="form-control" required />
						</div>
						<div class="col-md-4">
							<label for="orderId" class="form-label">Order ID</label>
							<input type="text" id="orderId" class="form-control" required />
						</div>
						<div class="col-md-2">
							<label for="amount" class="form-label">Montant</label>
							<input type="number" step="0.01" id="amount" class="form-control" required />
						</div>
						<div class="col-md-2">
							<label for="paymentMethod" class="form-label">Méthode</label>
							<select id="paymentMethod" class="form-select">
								<option value="card">Carte</option>
								<option value="paypal">PayPal</option>
								<option value="cash">Espèces</option>
							</select>
						</div>

						<div class="col-md-3">
							<label for="paymentStatus" class="form-label">Statut</label>
							<select id="paymentStatus" class="form-select">
								<option value="pending">En attente</option>
								<option value="completed">Complété</option>
								<option value="failed">Échoué</option>
							</select>
						</div>

						<div class="col-12">
							<button type="submit" class="btn btn-primary">Créer le paiement</button>
							<button type="button" id="refreshBtn" class="btn btn-secondary ms-2">Actualiser la liste</button>
						</div>
					</form>
				</div>
			</div>

			<div class="card">
				<div class="card-body">
					<h5 class="card-title">Liste des paiements</h5>
					<div class="table-responsive">
						<table class="table table-sm table-striped" id="paymentsTable">
							<thead>
								<tr>
									<th>ID</th>
									<th>User</th>
									<th>Order</th>
									<th>Montant</th>
									<th>Méthode</th>
									<th>Statut</th>
									<th>Créé le</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody></tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- Filtres et Recherche -->
			<div class="card mt-4">
				<div class="card-header">
					<h5 class="mb-0">Filtres & Recherche</h5>
				</div>
				<div class="card-body">
					<div class="row g-3">
						<div class="col-md-3">
							<label for="filterUserId" class="form-label">Paiements par User ID</label>
							<input type="text" id="filterUserId" class="form-control" placeholder="ex: user123" />
						</div>
						<div class="col-md-3">
							<label for="filterOrderId" class="form-label">Paiements par Order ID</label>
							<input type="text" id="filterOrderId" class="form-control" placeholder="ex: order456" />
						</div>
						<div class="col-md-2">
							<label for="filterMethod" class="form-label">Par Méthode</label>
							<select id="filterMethod" class="form-select">
								<option value="">-- Tous --</option>
								<option value="card">Carte</option>
								<option value="paypal">PayPal</option>
								<option value="cash">Espèces</option>
							</select>
						</div>
						<div class="col-md-2">
							<label for="filterStatus" class="form-label">Par Statut</label>
							<select id="filterStatus" class="form-select">
								<option value="">-- Tous --</option>
								<option value="pending">En attente</option>
								<option value="completed">Complété</option>
								<option value="failed">Échoué</option>
							</select>
						</div>
						<div class="col-md-2 d-flex align-items-end">
							<button class="btn btn-info w-100" id="applyFiltersBtn">Appliquer filtres</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Statistiques -->
			<div class="card mt-4">
				<div class="card-header">
					<h5 class="mb-0">Statistiques Globales</h5>
				</div>
				<div class="card-body">
					<div class="row" id="statsContainer">
						<div class="col-md-3">
							<div class="card bg-primary text-white">
								<div class="card-body">
									<h6 class="card-title">Total Paiements</h6>
									<p class="card-text" id="statTotal">-</p>
								</div>
							</div>
						</div>
						<div class="col-md-3">
							<div class="card bg-success text-white">
								<div class="card-body">
									<h6 class="card-title">Nombre de Paiements</h6>
									<p class="card-text" id="statCount">-</p>
								</div>
							</div>
						</div>
						<div class="col-md-3">
							<div class="card bg-warning text-white">
								<div class="card-body">
									<h6 class="card-title">Montant Moyen</h6>
									<p class="card-text" id="statAverage">-</p>
								</div>
							</div>
						</div>
						<div class="col-md-3">
							<button class="btn btn-secondary w-100 h-100" id="refreshStatsBtn">Actualiser Stats</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Statistiques détaillées -->
			<div class="row mt-4">
				<div class="col-md-6">
					<div class="card">
						<div class="card-header">
							<h5 class="mb-0">Paiements par Méthode</h5>
						</div>
						<div class="card-body">
							<ul class="list-group" id="statsMethods"></ul>
						</div>
					</div>
				</div>
				<div class="col-md-6">
					<div class="card">
						<div class="card-header">
							<h5 class="mb-0">Paiements par Statut</h5>
						</div>
						<div class="card-body">
							<ul class="list-group" id="statsStatus"></ul>
						</div>
					</div>
				</div>
			</div>

			<!-- Historique par plage de dates -->
			<div class="card mt-4">
				<div class="card-header">
					<h5 class="mb-0">Paiements par Plage de Dates</h5>
				</div>
				<div class="card-body">
					<div class="row g-3">
						<div class="col-md-3">
							<label for="dateStart" class="form-label">Date début</label>
							<input type="date" id="dateStart" class="form-control" />
						</div>
						<div class="col-md-3">
							<label for="dateEnd" class="form-label">Date fin</label>
							<input type="date" id="dateEnd" class="form-control" />
						</div>
						<div class="col-md-3 d-flex align-items-end">
							<button class="btn btn-warning w-100" id="filterDateRangeBtn">Chercher</button>
						</div>
						<div class="col-md-3 d-flex align-items-end">
							<button class="btn btn-info w-100" id="recentPaymentsBtn">Paiements Récents (10)</button>
						</div>
					</div>
					<div id="dateRangeResultsContainer" class="mt-3"></div>
				</div>
			</div>
		</div>

		<script>
			const apiBase = '/api/payments';

			async function fetchPayments() {
				try {
					const res = await fetch(apiBase);
					if (!res.ok) {
						throw new Error(`HTTP error! status: ${res.status}`);
					}
					const list = await res.json();
					const tbody = document.querySelector('#paymentsTable tbody');
					tbody.innerHTML = '';
					list.forEach(p => {
						const tr = document.createElement('tr');
						tr.innerHTML = `
							<td>${p._id}</td>
							<td>${p.userId || ''}</td>
							<td>${p.orderId || ''}</td>
							<td>${p.amount ?? ''}</td>
							<td>${p.paymentMethod || ''}</td>
							<td>${p.paymentStatus || ''}</td>
							<td>${p.createdAt ? new Date(p.createdAt).toLocaleString() : ''}</td>
							<td>
								<button class="btn btn-sm btn-success" data-id="${p._id}" data-action="complete">Valider</button>
								<button class="btn btn-sm btn-danger ms-1" data-id="${p._id}" data-action="delete">Supprimer</button>
							</td>
						`;
						tbody.appendChild(tr);
					});
				} catch (err) {
					console.error('Fetch error:', err);
					alert('Erreur lors de la récupération des paiements: ' + err.message);
				}
			}

			document.getElementById('paymentForm').addEventListener('submit', async (e) => {
				e.preventDefault();
				const payload = {
					userId: document.getElementById('userId').value,
					orderId: document.getElementById('orderId').value,
					amount: parseFloat(document.getElementById('amount').value),
					paymentMethod: document.getElementById('paymentMethod').value,
					paymentStatus: document.getElementById('paymentStatus').value
				};
				try {
					const res = await fetch(apiBase, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload)
					});
					if (!res.ok) throw new Error('Création échouée');
					document.getElementById('paymentForm').reset();
					await fetchPayments();
				} catch (err) {
					console.error(err);
					alert('Erreur lors de la création du paiement');
				}
			});

			document.getElementById('refreshBtn').addEventListener('click', fetchPayments);

			document.querySelector('#paymentsTable tbody').addEventListener('click', async (e) => {
				const btn = e.target.closest('button');
				if (!btn) return;
				const id = btn.dataset.id;
				const action = btn.dataset.action;
				if (action === 'delete') {
					if (!confirm('Supprimer ce paiement ?')) return;
					try {
						const res = await fetch(`${apiBase}/${id}`, { method: 'DELETE' });
						if (!res.ok) throw new Error('Suppression échouée');
						await fetchPayments();
					} catch (err) {
						console.error(err);
						alert('Erreur suppression');
					}
				} else if (action === 'complete') {
					try {
						const res = await fetch(`${apiBase}/${id}`, {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ paymentStatus: 'completed' })
						});
						if (!res.ok) throw new Error('Mise à jour échouée');
						await fetchPayments();
					} catch (err) {
						console.error(err);
						alert('Erreur mise à jour');
					}
				}
			});

			// load on start
			fetchPayments();
			loadStatistics();

			// Filtres
			document.getElementById('applyFiltersBtn').addEventListener('click', async () => {
				const userId = document.getElementById('filterUserId').value;
				const orderId = document.getElementById('filterOrderId').value;
				const method = document.getElementById('filterMethod').value;
				const status = document.getElementById('filterStatus').value;

				let url = apiBase;
				if (userId) url = `${apiBase}/user/${userId}`;
				else if (orderId) url = `${apiBase}/order/${orderId}`;
				else if (method) url = `${apiBase}/method/${method}`;
				else if (status) url = `${apiBase}/status/${status}`;

				try {
					const res = await fetch(url);
					if (!res.ok) throw new Error('Erreur filtrage');
					const list = await res.json();
					const tbody = document.querySelector('#paymentsTable tbody');
					tbody.innerHTML = '';
					list.forEach(p => {
						const tr = document.createElement('tr');
						tr.innerHTML = `
							<td>${p._id}</td>
							<td>${p.userId || ''}</td>
							<td>${p.orderId || ''}</td>
							<td>${p.amount ?? ''}</td>
							<td>${p.paymentMethod || ''}</td>
							<td>${p.paymentStatus || ''}</td>
							<td>${p.createdAt ? new Date(p.createdAt).toLocaleString() : ''}</td>
							<td>
								<button class="btn btn-sm btn-success" data-id="${p._id}" data-action="complete">Valider</button>
								<button class="btn btn-sm btn-danger ms-1" data-id="${p._id}" data-action="delete">Supprimer</button>
							</td>
						`;
						tbody.appendChild(tr);
					});
				} catch (err) {
					console.error(err);
					alert('Erreur filtrage: ' + err.message);
				}
			});

			// Statistiques
			async function loadStatistics() {
				try {
					const [totalRes, countRes, avgRes, methodsRes, statusRes] = await Promise.all([
						fetch(`${apiBase}/stats/total`),
						fetch(`${apiBase}/stats/count`),
						fetch(`${apiBase}/stats/average`),
						fetch(`${apiBase}/stats/methods`),
						fetch(`${apiBase}/stats/status-breakdown`)
					]);

					const total = await totalRes.json();
					const count = await countRes.json();
					const avg = await avgRes.json();
					const methods = await methodsRes.json();
					const statuses = await statusRes.json();

					document.getElementById('statTotal').textContent = total.totalAmount?.toFixed(2) || '0';
					document.getElementById('statCount').textContent = count.count || '0';
					document.getElementById('statAverage').textContent = avg.averageAmount?.toFixed(2) || '0';

					// Méthodes
					const methodsList = document.getElementById('statsMethods');
					methodsList.innerHTML = '';
					methods.forEach(m => {
						const li = document.createElement('li');
						li.className = 'list-group-item d-flex justify-content-between';
						li.innerHTML = `<span>${m._id || 'N/A'}</span><span class="badge bg-info">${m.count}</span>`;
						methodsList.appendChild(li);
					});

					// Statuts
					const statusList = document.getElementById('statsStatus');
					statusList.innerHTML = '';
					statuses.forEach(s => {
						const li = document.createElement('li');
						li.className = 'list-group-item d-flex justify-content-between';
						const badgeClass = s._id === 'completed' ? 'bg-success' : s._id === 'pending' ? 'bg-warning' : 'bg-danger';
						li.innerHTML = `<span>${s._id || 'N/A'}</span><span class="badge ${badgeClass}">${s.count}</span>`;
						statusList.appendChild(li);
					});
				} catch (err) {
					console.error('Stats error:', err);
				}
			}

			document.getElementById('refreshStatsBtn').addEventListener('click', loadStatistics);

			// Paiements par plage de dates
			document.getElementById('filterDateRangeBtn').addEventListener('click', async () => {
				const startDate = document.getElementById('dateStart').value;
				const endDate = document.getElementById('dateEnd').value;

				if (!startDate || !endDate) {
					alert('Veuillez sélectionner les deux dates');
					return;
				}

				try {
					const res = await fetch(`${apiBase}/daterange/list?startDate=${startDate}&endDate=${endDate}`);
					if (!res.ok) throw new Error('Erreur requête');
					const list = await res.json();
					const container = document.getElementById('dateRangeResultsContainer');
					container.innerHTML = `<p class="text-muted">${list.length} paiement(s) trouvé(s)</p>`;
				} catch (err) {
					console.error(err);
					alert('Erreur plage de dates');
				}
			});

			// Paiements récents
			document.getElementById('recentPaymentsBtn').addEventListener('click', async () => {
				try {
					const res = await fetch(`${apiBase}/recent/list?limit=10`);
					if (!res.ok) throw new Error('Erreur requête');
					const list = await res.json();
					const tbody = document.querySelector('#paymentsTable tbody');
					tbody.innerHTML = '';
					list.forEach(p => {
						const tr = document.createElement('tr');
						tr.innerHTML = `
							<td>${p._id}</td>
							<td>${p.userId || ''}</td>
							<td>${p.orderId || ''}</td>
							<td>${p.amount ?? ''}</td>
							<td>${p.paymentMethod || ''}</td>
							<td>${p.paymentStatus || ''}</td>
							<td>${p.createdAt ? new Date(p.createdAt).toLocaleString() : ''}</td>
							<td>
								<button class="btn btn-sm btn-success" data-id="${p._id}" data-action="complete">Valider</button>
								<button class="btn btn-sm btn-danger ms-1" data-id="${p._id}" data-action="delete">Supprimer</button>
							</td>
						`;
						tbody.appendChild(tr);
					});
				} catch (err) {
					console.error(err);
					alert('Erreur paiements récents');
				}
			});
		</script>
	</body>
</html>
